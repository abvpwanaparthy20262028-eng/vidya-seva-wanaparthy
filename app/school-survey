export default function SchoolSurveyPage() {
  const router = useRouter();
  const [step,setStep] = useState(0);
  const [answers,setAnswers] = useState<Record<string, any>>({});
  const [error,setError] = useState("");
  const [busy,setBusy] = useState(false);
  const [code,setCode] = useState("");
  const [done,setDone] = useState(false);
  const [title, fields] = sections[step] as any;

  const update = (id:string, value:any) => setAnswers((old)=>({...old,[id]:value}));
  function validate() {
    for (const f of fields as any[]) {
      if (f[3] && (answers[f[0]] === undefined || answers[f[0]] === "" || answers[f[0]] === false)) {
        return `దయచేసి “${f[1]}” వివరాన్ని నమోదు చేయండి.`;
      }
    }
    return "";
  }
  function next() {
    const msg=validate(); if(msg){setError(msg);return;}
    setError("");setStep(s=>Math.min(s+1,sections.length-1));window.scrollTo({top:0,behavior:"smooth"});
  }
  async function submit(e:FormEvent) {
    e.preventDefault(); const msg=validate();if(msg){setError(msg);return;}
    setBusy(true);setError("");
    const {data:auth,error:authErr}=await supabase.auth.getUser();
    if(authErr || !auth.user){setBusy(false);setError("సర్వే భద్రపరచడానికి ముందుగా లాగిన్ అవ్వండి.");setTimeout(()=>router.push("/login?next=/school-survey"),1000);return;}
    const {data, error:dbErr}=await supabase.from("school_surveys").insert({
      school_name:String(answers.school_name||""),mandal:String(answers.mandal||""),
      village:String(answers.village||""),answers,submitted_by:auth.user.id
    }).select("survey_code,id").single();
    setBusy(false);
    if(dbErr){setError(dbErr.message.includes("school_surveys")?"డేటాబేస్ పట్టిక ఇంకా సృష్టించలేదు. ZIP లోని SQL ను Supabase SQL Editor లో అమలు చేయండి.":`సమర్పణ విఫలమైంది: ${dbErr.message}`);return;}
    setCode(data?.survey_code || String(data?.id));setDone(true);
  }

  const inputClass="mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-base focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-100";
  return <main className="min-h-screen bg-slate-50 px-4 py-8 text-slate-900 sm:px-6"><div className="mx-auto max-w-3xl">
    <header className="mb-6 rounded-2xl bg-emerald-900 p-6 text-white shadow">
      <p className="font-semibold text-emerald-100">విద్యా సేవ – వనపర్తి</p><h1 className="mt-2 text-2xl font-bold sm:text-3xl">ప్రభుత్వ పాఠశాలల సమగ్ర సర్వే</h1>
      <p className="mt-2 text-sm text-emerald-50">పాఠశాల పరిస్థితులు, మౌలిక సదుపాయాలు, సమస్యల నమోదు</p>
      {!done && <><div className="mt-5 flex justify-between text-sm"><span>విభాగం {step+1} / {sections.length}</span><span>{Math.round((step+1)/sections.length*100)}%</span></div><div className="mt-2 h-2 rounded-full bg-emerald-800"><div className="h-2 rounded-full bg-amber-300" style={{width:`${(step+1)/sections.length*100}%`}} /></div></>}
    </header>
    {done ? <section className="rounded-2xl border border-emerald-200 bg-white p-6"><h2 className="text-xl font-bold text-emerald-800">సర్వే విజయవంతంగా సమర్పించబడింది</h2><p className="mt-3">సర్వే గుర్తింపు సంఖ్య:</p><p className="mt-2 break-all rounded-lg bg-emerald-50 p-4 text-lg font-bold">{code}</p><button onClick={()=>window.location.reload()} className="mt-5 rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white">మరో సర్వే నమోదు చేయండి</button></section> :
    <form onSubmit={submit} className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
      <h2 className="text-xl font-bold">{title}</h2><p className="mt-1 mb-6 text-sm text-slate-500">అందుబాటులో ఉన్న వివరాలను నమోదు చేయండి. * ఉన్నవి తప్పనిసరి.</p>
      <div className="space-y-5">{(fields as any[]).map(f=><div key={f[0]}>
        <label htmlFor={f[0]} className="block text-sm font-semibold">{f[1]}{f[3]&&<span className="text-red-600"> *</span>}</label>
        {f[2]==="textarea" ? <textarea id={f[0]} required={!!f[3]} rows={3} value={answers[f[0]]||""} onChange={e=>update(f[0],e.target.value)} className={inputClass} placeholder="వివరాలు నమోదు చేయండి"/> :
        f[2]==="select" ? <select id={f[0]} required={!!f[3]} value={answers[f[0]]||""} onChange={e=>update(f[0],e.target.value)} className={inputClass}><option value="">ఎంచుకోండి</option>{(f[4]||[]).map((o:string)=><option key={o}>{o}</option>)}</select> :
        f[2]==="checkbox" ? <div className="mt-3"><input id={f[0]} type="checkbox" required={!!f[3]} checked={!!answers[f[0]]} onChange={e=>update(f[0],e.target.checked)} className="mr-3 h-5 w-5 accent-emerald-800"/><label htmlFor={f[0]}>అవును, ధృవీకరిస్తున్నాను</label></div> :
        <input id={f[0]} type={f[2]} required={!!f[3]} min={f[2]==="number"?0:undefined} value={answers[f[0]]??""} onChange={e=>update(f[0],f[2]==="number"?(e.target.value===""?"":Number(e.target.value)):e.target.value)} className={inputClass}/>}
      </div>)}</div>
      {error&&<p role="alert" className="mt-5 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">{error}</p>}
      <div className="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
        <button type="button" disabled={step===0||busy} onClick={()=>{setError("");setStep(s=>Math.max(0,s-1));window.scrollTo({top:0,behavior:"smooth"});}} className="rounded-lg border border-slate-300 px-5 py-3 font-semibold disabled:opacity-40">వెనక్కి</button>
        {step<sections.length-1 ? <button type="button" onClick={next} className="rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white">తదుపరి విభాగం →</button> :
        <button type="submit" disabled={busy} className="rounded-lg bg-amber-400 px-5 py-3 font-bold text-slate-950 disabled:opacity-50">{busy?"సమర్పిస్తోంది...":"సర్వే సమర్పించండి"}</button>}
      </div>
    </form>}
    <p className="mt-5 text-center text-xs text-slate-500">విద్యా సేవ – వనపర్తి</p>
  </div></main>;
}
